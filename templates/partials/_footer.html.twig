{% from 'partials/_icons.html.twig' import facebook, instagram, linkedin, twitter, phone, whatsapp, email, location %}

{# Footer #}
<footer class="footer">
    <div class="footer__main">
        <div class="container">
            <div class="footer__grid">
                {# Colonne 1 : Marque #}
                <div class="footer__col">
                    <a href="{{ path('app_home') }}" class="footer__brand">
                        <img src="{{ asset('images/logo.png') }}" alt="Alliance Esthetic" class="footer__logo">
                    </a>
                </div>

                {# Colonne 2 : Liens rapides #}
                <div class="footer__col footer__col--links">
                    <h3 class="footer__title">Liens rapides</h3>
                    <ul class="footer__links">
                        <li><a href="{{ path('app_home') }}">Accueil</a></li>
                        <li><a href="{{ path('app_services') }}">Services</a></li>
                        <li><a href="#">Assurance</a></li>
                        <li><a href="#">Contact</a></li>
                    </ul>
                </div>

                {# Colonne 3 : Contact #}
                <div class="footer__col footer__col--contact">
                    <h3 class="footer__title">Contactez-nous</h3>
                    <ul class="footer__contact">
                        <li>
                            {{ whatsapp() }}
                            <a href="https://wa.me/33614863505">+33 6 14 86 35 05</a>
                        </li>
                        <li>
                            {{ email() }}
                            <a href="mailto:contact@alliance-esthetic.fr">contact@alliance-esthetic.fr</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="footer__social-bar">
                <a href="#" aria-label="Facebook">{{ facebook() }}</a>
                <a href="#" aria-label="Instagram">{{ instagram() }}</a>
                <a href="#" aria-label="LinkedIn">{{ linkedin() }}</a>
            </div>
        </div>
    </div>

    {# Bottom Bar #}
    <div class="footer__bottom">
        <div class="container">
            <div class="footer__social footer__social--mobile">
                <a href="#" aria-label="Facebook">{{ facebook() }}</a>
                <a href="#" aria-label="Instagram">{{ instagram() }}</a>
                <a href="#" aria-label="LinkedIn">{{ linkedin() }}</a>
            </div>
            <p>&copy; 2026 Alliance Esthetic. Tous droits réservés. — Réalisé par <a href="https://entryweb.fr" target="_blank" rel="noopener noreferrer"><strong>EntryWeb</strong></a></p>
            <div class="footer__legal">
                <a href="#">Mentions légales</a>
                <a href="#">Politique de confidentialité</a>
                <a href="#">CGV</a>
            </div>
        </div>
    </div>
</footer>
