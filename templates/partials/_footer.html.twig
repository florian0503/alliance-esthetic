{% from 'partials/_icons.html.twig' import snapchat, whatsapp, email %}

{# Footer #}
<footer class="footer">
    <div class="footer__main">
        <div class="container">
            <div class="footer__grid">
                {# Colonne 1 : Marque #}
                <div class="footer__col">
                    <a href="{{ path('app_home') }}" class="footer__brand">
                        <img src="{{ asset('images/logo.png') }}" alt="Alliance Esthetic" class="footer__logo">
                    </a>
                    <p class="footer__desc">Du Maghreb à la Turquie, nous révélons le meilleur de vous-même. Greffe capillaire & dentisterie esthétique.</p>
                </div>

                {# Colonne 2 : Liens rapides #}
                <div class="footer__col footer__col--links">
                    <h3 class="footer__title">Liens rapides</h3>
                    <ul class="footer__links">
                        <li><a href="{{ path('app_home') }}">Accueil</a></li>
                        <li><a href="{{ path('app_services') }}">Services</a></li>
                        <li><a href="{{ path('app_assurance') }}">Assurance</a></li>
                        <li><a href="{{ path('app_contact') }}">Contact</a></li>
                    </ul>
                </div>

                {# Colonne 3 : Nos services #}
                <div class="footer__col footer__col--services">
                    <h3 class="footer__title">Nos services</h3>
                    <ul class="footer__links">
                        <li><a href="{{ path('app_services') }}#capillaire">Greffe FUE</a></li>
                        <li><a href="{{ path('app_services') }}#capillaire">Technique DHI</a></li>
                        <li><a href="{{ path('app_services') }}#capillaire">Greffe de Barbe</a></li>
                        <li><a href="{{ path('app_services') }}#dentaire">Facettes E.MAX</a></li>
                        <li><a href="{{ path('app_services') }}#dentaire">Traitement par Gouttière</a></li>
                    </ul>
                </div>

                {# Colonne 4 : Contact #}
                <div class="footer__col footer__col--contact">
                    <h3 class="footer__title">Contactez-nous</h3>
                    <ul class="footer__contact">
                        <li>
                            {{ whatsapp() }}
                            <a href="https://wa.me/33614863505">+33 6 14 86 35 05</a>
                        </li>
                        <li>
                            {{ email() }}
                            <a href="mailto:alliance.esthetic@gmail.com">alliance.esthetic@gmail.com</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="footer__social-bar">
                <a href="{{ social_whatsapp_url }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">{{ whatsapp() }}</a>
                <a href="{{ social_snapchat_url }}" target="_blank" rel="noopener noreferrer" aria-label="Snapchat">{{ snapchat() }}</a>
            </div>
        </div>
    </div>

    {# Bottom Bar #}
    <div class="footer__bottom">
        <div class="container">
            <div class="footer__social footer__social--mobile">
                <a href="{{ social_whatsapp_url }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">{{ whatsapp() }}</a>
                <a href="{{ social_snapchat_url }}" target="_blank" rel="noopener noreferrer" aria-label="Snapchat">{{ snapchat() }}</a>
            </div>
            <p>&copy; 2026 Alliance Esthetic. Tous droits réservés. — Réalisé par <a href="https://entryweb.fr" target="_blank" rel="noopener noreferrer"><strong>EntryWeb</strong></a></p>
            <div class="footer__legal">
                <a href="{{ path('app_mentions_legales') }}">Mentions légales</a>
                <a href="{{ path('app_politique_confidentialite') }}">Politique de confidentialité</a>
                <a href="{{ path('app_cgv') }}">CGV</a>
                <button type="button" class="footer__legal-btn" id="cookie-prefs">Cookies</button>
            </div>
        </div>
    </div>
</footer>
