{% extends 'base.html.twig' %}

{% block title %}Alliance Esthetic — Mutuelle & Assurance{% endblock %}

{% block body %}

    {# Hero #}
    <section class="assurance-hero">
        <div class="container">
            <h1 class="assurance-hero__title">Comprendre la prise en charge<br>de vos soins</h1>
            <p class="assurance-hero__subtitle">
                La médecine esthétique relève principalement du confort personnel.
                Néanmoins, certains actes de chirurgie ou dermatologie réparatrice
                peuvent faire l'objet d'un remboursement partiel.
            </p>
        </div>
    </section>

    {# Contenu principal : 2 colonnes #}
    <section class="assurance-content">
        <div class="container">
            <div class="assurance-grid">

                {# Colonne gauche : Quels actes ? #}
                <div class="assurance-actes reveal reveal--left">
                    <h2 class="assurance-actes__title">Quels actes sont concernés ?</h2>

                    {# Actes esthétiques purs #}
                    <div class="assurance-acte-block">
                        <div class="assurance-acte-block__label assurance-acte-block__label--warning">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                                <line x1="12" y1="9" x2="12" y2="13"/>
                                <line x1="12" y1="17" x2="12.01" y2="17"/>
                            </svg>
                            ACTES ESTHÉTIQUES PURS
                        </div>
                        <p class="assurance-acte-block__text">
                            Les actes à visée purement esthétique (injections d'acide hyaluronique pour le rajeunissement, épilation laser de confort, peeling esthétiques) <strong>ne sont pas pris en charge</strong> par la Sécurité Sociale ni par votre mutuelle.
                        </p>
                        <ul class="assurance-acte-block__list">
                            <li>Injections anti-rides</li>
                            <li>Épilation définitive classique</li>
                            <li>Remodelage corporel esthétique</li>
                            <li>Soins hydratants profonds</li>
                        </ul>
                    </div>

                    {# Actes réparateurs #}
                    <div class="assurance-acte-block">
                        <div class="assurance-acte-block__label assurance-acte-block__label--success">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                <polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                            ACTES RÉPARATEURS
                        </div>
                        <p class="assurance-acte-block__text">
                            Certains traitements à visée réparatrice ou pathologique peuvent bénéficier d'une prise en charge après accord préalable de la CPAM (ex : hyperhidrose sévère, traitement des cicatrices post-traumatiques, épilation médicale dans certains cas d'hirsutisme).
                        </p>
                    </div>
                </div>

                {# Colonne droite : Vos démarches #}
                <div class="assurance-demarches reveal reveal--right">
                    <h2 class="assurance-demarches__title">Vos démarches</h2>

                    <div class="assurance-steps">
                        <div class="assurance-step">
                            <div class="assurance-step__num">1</div>
                            <div class="assurance-step__body">
                                <h3 class="assurance-step__title">LA CONSULTATION INITIALE</h3>
                                <p class="assurance-step__text">Lors de votre première visite, notre médecin évaluera si votre demande relève de l'esthétique pure ou du réparateur. Un devis clair et détaillé vous sera systématiquement remis.</p>
                            </div>
                        </div>

                        <div class="assurance-step">
                            <div class="assurance-step__num">2</div>
                            <div class="assurance-step__body">
                                <h3 class="assurance-step__title">L'ACCORD PRÉALABLE</h3>
                                <p class="assurance-step__text">Si l'acte est susceptible d'être pris en charge, nous remplirons ensemble une demande d'entente préalable à envoyer à votre Caisse d'Assurance Maladie.</p>
                            </div>
                        </div>

                        <div class="assurance-step">
                            <div class="assurance-step__num">3</div>
                            <div class="assurance-step__body">
                                <h3 class="assurance-step__title">FACTURATION ET MUTUELLE</h3>
                                <p class="assurance-step__text">Après l'intervention, une note d'honoraires vous sera remise. Vous pourrez la transmettre à votre mutuelle pour connaître le montant de votre reste à charge éventuel.</p>
                            </div>
                        </div>
                    </div>

                    {# Carte transparence #}
                    <div class="assurance-transparency">
                        <div class="assurance-transparency__icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>
                        </div>
                        <div>
                            <h4 class="assurance-transparency__title">Transparence Totale</h4>
                            <p class="assurance-transparency__text">Chez Alliance Esthetic, nous mettons un point d'honneur à vous informer de façon exhaustive sur les coûts et les éventuelles prises en charge avant tout acte médical. Aucun soin n'est débuté sans votre consentement éclairé.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    {# CTA section #}
    <section class="assurance-cta">
        <div class="container">
            <h2 class="assurance-cta__title">Des questions sur votre dossier ?</h2>
            <p class="assurance-cta__text">Nos secrétaires médicales sont disponibles pour vous accompagner dans vos démarches administratives et répondre à toutes vos interrogations.</p>
            <a href="{{ path('app_contact') }}" class="btn btn--dark">CONTACTER LE SECRÉTARIAT</a>
        </div>
    </section>

{% endblock %}
