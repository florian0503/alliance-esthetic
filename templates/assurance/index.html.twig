{% extends 'base.html.twig' %}

{% block title %}Alliance Esthetic — Assurance 1 an{% endblock %}

{% block body %}

    {# Banner — identique aux autres pages #}
    <section class="page-banner">
        <div class="page-banner__content">
            <h1 class="page-banner__title">Assurance <span style="color:#6ab1d9">1 an</span></h1>
            <p class="page-banner__subtitle">Prise en charge complète dès votre première visite</p>
            <div class="page-banner__breadcrumb">
                <a href="{{ path('app_home') }}">Accueil</a>
                <span>/</span>
                <span>Assurance</span>
            </div>
        </div>
    </section>

    {# Ce que couvre l'assurance #}
    <section class="asr-covers">
        <div class="container">
            <div class="asr-header reveal">
                <span class="asr-label">INCLUS DANS VOTRE ASSURANCE</span>
                <h2 class="asr-title">Ce que nous prenons en charge</h2>
            </div>
            <div class="asr-cards reveal">
                <div class="asr-card">
                    <div class="asr-card__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
                    </div>
                    <h3>Billet d'avion</h3>
                    <p>Avancé par le patient, remboursé à l'arrivée sur présentation de la facture.</p>
                </div>
                <div class="asr-card">
                    <div class="asr-card__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    </div>
                    <h3>Hébergement</h3>
                    <p>Logement intégralement pris en charge pour toute la durée du séjour médical.</p>
                </div>
                <div class="asr-card">
                    <div class="asr-card__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    </div>
                    <h3>Transferts</h3>
                    <p>Tous les trajets (aéroport, clinique, hôtel) organisés et financés par nos soins.</p>
                </div>
                <div class="asr-card">
                    <div class="asr-card__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    </div>
                    <h3>Soins médicaux</h3>
                    <p>Couverts sous réserve d'une étude préalable du dossier par notre cabinet.</p>
                </div>
            </div>
        </div>
    </section>

    {# Conditions #}
    <section class="asr-conditions">
        <div class="container">
            <div class="asr-header reveal">
                <span class="asr-label">CONDITIONS</span>
                <h2 class="asr-title">Les règles à respecter pour maintenir la garantie</h2>
            </div>
            <div class="asr-steps reveal">
                <div class="asr-step">
                    <div class="asr-step__num">01</div>
                    <div class="asr-step__body">
                        <h3>Alimentation</h3>
                        <p>Alimentation molle uniquement. Les aliments durs (biscuits, bonbons, fruits à coque) peuvent fragiliser les prothèses et annuler la garantie.</p>
                    </div>
                </div>
                <div class="asr-step">
                    <div class="asr-step__num">02</div>
                    <div class="asr-step__body">
                        <h3>Mouvements</h3>
                        <p>Éviter tout mouvement susceptible de fragiliser les tissus dentaires et de compromettre la bonne intégration des implants.</p>
                    </div>
                </div>
                <div class="asr-step">
                    <div class="asr-step__num">03</div>
                    <div class="asr-step__body">
                        <h3>Hygiène</h3>
                        <p>Hygiène bucco-dentaire irréprochable. Condition absolue pour la facturation de l'assurance et la préservation des implants provisoires.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Notes importantes #}
    <section class="asr-notes">
        <div class="container">
            <div class="asr-note asr-note--warning reveal">
                <div class="asr-note__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </div>
                <div>
                    <h4>Prothèses provisoires en PMMA</h4>
                    <p>Posées en fin de première pose. En cas de détérioration liée au non-respect des consignes, une seconde prothèse provisoire sera <strong>entièrement à la charge du patient</strong>. Nos prothèses sont en <strong>PMMA</strong>, matériau reconnu pour sa solidité.</p>
                </div>
            </div>
            <div class="asr-note asr-note--info reveal">
                <div class="asr-note__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </div>
                <div>
                    <h4>Après expiration de la période de 1 an</h4>
                    <p>Au-delà de cette période, en cas de complications, le patient prend à sa charge les frais d'hébergement, transferts et billet d'avion. Les soins ponctuels sont évalués au cas par cas par nos prestataires.</p>
                </div>
            </div>
        </div>
    </section>

    {# CTA #}
    <section class="asr-cta">
        <div class="container">
            <div class="asr-cta__inner reveal">
                <h2>Notre réseau de cliniques partenaires</h2>
                <p>Des cliniques sélectionnées pour leur excellence à Alger, Lyon et Paris pour assurer votre suivi.</p>
                <a href="{{ path('app_contact') }}" class="btn btn--primary">Prendre rendez-vous</a>
            </div>
        </div>
    </section>

{% endblock %}
