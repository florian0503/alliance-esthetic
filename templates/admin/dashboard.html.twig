{% extends '@EasyAdmin/page/content.html.twig' %}

{% block main %}
<div style="padding: 32px;">
    <h1 style="font-size:1.6rem;font-weight:700;color:#111;margin-bottom:8px;">Tableau de bord</h1>
    <p style="color:#64748b;margin-bottom:32px;">Bienvenue dans l'administration Alliance Esthetic.</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;">
        <a href="{{ ea_url().setController('App\\Controller\\Admin\\ReservationCrudController').setAction('index') }}"
           style="background:#fff;border-radius:12px;padding:24px;box-shadow:0 2px 12px rgba(0,0,0,0.07);text-decoration:none;border:1px solid #e8e4de;display:block;">
            <div style="font-size:2rem;margin-bottom:8px;">📅</div>
            <div style="font-size:1.1rem;font-weight:700;color:#111;">Réservations</div>
            <div style="font-size:0.85rem;color:#64748b;margin-top:4px;">Gérer les rendez-vous</div>
        </a>
    </div>
</div>
{% endblock %}
