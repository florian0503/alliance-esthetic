{% extends 'base.html.twig' %}

{% block title %}Alliance Esthetic — Réserver en ligne{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css">
<style>
    /* ── Page layout ── */
    .reservation-page {
        background: #f8f7f5;
        min-height: 100vh;
        padding-bottom: 80px;
    }

    /* ── Hero banner ── */
    .reservation-hero {
        background: #0A0A0A;
        padding: 64px 0 48px;
        text-align: center;
    }

    .reservation-hero__label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #6ab1d9;
        margin-bottom: 16px;
    }

    .reservation-hero__title {
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        font-weight: 700;
        color: #fff;
        margin-bottom: 12px;
    }

    .reservation-hero__subtitle {
        color: #94a3b8;
        font-size: 1rem;
        max-width: 520px;
        margin: 0 auto;
        line-height: 1.7;
    }

    /* ── Steps indicator ── */
    .reservation-steps {
        background: #fff;
        border-bottom: 1px solid #e8e4df;
        padding: 0;
    }

    .reservation-steps__inner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        max-width: 600px;
        margin: 0 auto;
    }

    .res-step {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 24px;
        flex: 1;
        justify-content: center;
    }

    .res-step__num {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #e2e8f0;
        color: #94a3b8;
        font-size: 0.8rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background 0.2s, color 0.2s;
    }

    .res-step__label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #94a3b8;
        transition: color 0.2s;
    }

    .res-step.is-active .res-step__num {
        background: #6ab1d9;
        color: #fff;
    }

    .res-step.is-active .res-step__label {
        color: #111;
    }

    .res-step.is-done .res-step__num {
        background: #22c55e;
        color: #fff;
    }

    .res-step.is-done .res-step__label {
        color: #64748b;
    }

    .res-step__sep {
        width: 32px;
        height: 1px;
        background: #e2e8f0;
        flex-shrink: 0;
    }

    /* ── Main content ── */
    .reservation-body {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .reservation-layout {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 32px;
        align-items: start;
    }

    /* ── Calendar card ── */
    .calendar-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.07);
        overflow: hidden;
    }

    .calendar-card__head {
        padding: 20px 24px 16px;
        border-bottom: 1px solid #f1f0ee;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .calendar-card__title {
        font-size: 1rem;
        font-weight: 700;
        color: #111;
    }

    .calendar-card__legend {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 0.78rem;
        color: #64748b;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
    }

    .legend-dot--free   { background: #6ab1d9; }
    .legend-dot--taken  { background: #e2e8f0; }

    .calendar-card__body {
        padding: 20px;
    }

    /* ── FullCalendar overrides ── */
    #reservation-calendar {
        font-family: 'Inter', sans-serif;
    }

    .fc .fc-toolbar-title {
        font-size: 1rem;
        font-weight: 700;
        color: #111;
        text-transform: capitalize;
    }

    .fc .fc-button {
        background: #f1f5f9;
        border: none;
        color: #475569;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        box-shadow: none;
    }

    .fc .fc-button:hover,
    .fc .fc-button:focus {
        background: #e2e8f0;
        box-shadow: none;
    }

    .fc .fc-button-primary:not(:disabled).fc-button-active {
        background: #6ab1d9;
        color: #fff;
    }

    .fc .fc-col-header-cell-cushion {
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 10px 0;
    }

    .fc .fc-timegrid-slot {
        height: 56px;
    }

    .fc .fc-timegrid-slot-label-cushion {
        font-size: 0.78rem;
        color: #94a3b8;
    }

    .fc .fc-timegrid-col.fc-day-today {
        background: rgba(106, 177, 217, 0.05);
    }

    /* Créneau disponible */
    .fc-slot-available {
        background: rgba(106, 177, 217, 0.12) !important;
        border: 1.5px solid #6ab1d9 !important;
        border-radius: 6px !important;
        color: #1a6a99 !important;
        font-size: 0.78rem !important;
        font-weight: 600 !important;
        cursor: pointer !important;
        transition: background 0.2s !important;
    }

    .fc-slot-available:hover {
        background: rgba(106, 177, 217, 0.28) !important;
    }

    /* Créneau pris */
    .fc-slot-taken {
        background: #f1f5f9 !important;
        border: 1.5px solid #e2e8f0 !important;
        border-radius: 6px !important;
        color: #94a3b8 !important;
        font-size: 0.78rem !important;
        font-weight: 500 !important;
        cursor: not-allowed !important;
    }

    /* ── Sidebar ── */
    .reservation-sidebar {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .res-info-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.07);
        padding: 24px;
    }

    .res-info-card__title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #111;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #f1f0ee;
    }

    .res-info-card__selected {
        font-size: 0.9rem;
        color: #64748b;
        text-align: center;
        padding: 20px 0;
        border: 2px dashed #e2e8f0;
        border-radius: 10px;
        line-height: 1.6;
    }

    .res-info-card__selected strong {
        display: block;
        color: #111;
        font-size: 1rem;
        margin-top: 6px;
    }

    .res-info-card__selected.has-slot {
        border-color: #6ab1d9;
        background: rgba(106, 177, 217, 0.06);
    }

    .res-info-card__selected.has-slot strong {
        color: #1a6a99;
    }

    /* Horaires */
    .res-horaires {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .res-horaire-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.83rem;
        color: #64748b;
        padding: 6px 0;
        border-bottom: 1px solid #f8f7f5;
    }

    .res-horaire-item span:last-child {
        font-weight: 600;
        color: #111;
    }

    /* ── Booking Modal ── */
    .res-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s, visibility 0.25s;
    }

    .res-modal-backdrop.is-open {
        opacity: 1;
        visibility: visible;
    }

    .res-modal {
        background: #fff;
        border-radius: 20px;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        transform: translateY(16px);
        transition: transform 0.25s;
        overflow: hidden;
    }

    .res-modal-backdrop.is-open .res-modal {
        transform: translateY(0);
    }

    .res-modal__head {
        background: #0A0A0A;
        padding: 24px 28px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .res-modal__head-title {
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
    }

    .res-modal__head-slot {
        font-size: 0.85rem;
        color: #6ab1d9;
        margin-top: 4px;
    }

    .res-modal__close {
        background: rgba(255,255,255,0.1);
        border: none;
        color: #fff;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        font-size: 1.1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
        flex-shrink: 0;
    }

    .res-modal__close:hover {
        background: rgba(255,255,255,0.2);
    }

    .res-modal__body {
        padding: 28px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .res-modal__group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .res-modal__label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #475569;
    }

    .res-modal__required {
        color: #6ab1d9;
    }

    .res-modal__input,
    .res-modal__select {
        width: 100%;
        padding: 11px 14px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.9rem;
        color: #111;
        background: #f8f9fa;
        transition: border-color 0.2s, background 0.2s;
        font-family: 'Inter', sans-serif;
        box-sizing: border-box;
    }

    .res-modal__input:focus,
    .res-modal__select:focus {
        outline: none;
        border-color: #6ab1d9;
        background: #fff;
    }

    .res-modal__row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .res-modal__footer {
        padding: 0 28px 28px;
        display: flex;
        gap: 12px;
    }

    .res-modal__btn-cancel {
        flex: 1;
        padding: 13px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        background: transparent;
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

    .res-modal__btn-cancel:hover {
        background: #f8f9fa;
    }

    .res-modal__btn-confirm {
        flex: 2;
        padding: 13px;
        border: none;
        border-radius: 10px;
        background: #6ab1d9;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
    }

    .res-modal__btn-confirm:hover {
        background: #5a9fc5;
    }

    /* ── Confirmation toast ── */
    .res-toast {
        position: fixed;
        bottom: 32px;
        left: 50%;
        transform: translateX(-50%) translateY(80px);
        background: #111;
        color: #fff;
        padding: 14px 28px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        z-index: 2000;
        box-shadow: 0 8px 24px rgba(0,0,0,0.2);
        transition: transform 0.35s cubic-bezier(.25,.8,.25,1);
        white-space: nowrap;
    }

    .res-toast.is-visible {
        transform: translateX(-50%) translateY(0);
    }

    .res-toast svg {
        color: #22c55e;
    }

    /* ── Mobile ── */
    @media (max-width: 768px) {
        .reservation-hero {
            padding: 48px 20px 36px;
        }

        .reservation-layout {
            grid-template-columns: 1fr;
        }

        .reservation-sidebar {
            order: -1;
        }

        .res-step__label {
            display: none;
        }

        .calendar-card__body {
            padding: 12px;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="reservation-page">

    {# Hero #}
    <section class="reservation-hero">
        <span class="reservation-hero__label">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            PRISE DE RENDEZ-VOUS
        </span>
        <h1 class="reservation-hero__title">Réservez votre consultation</h1>
        <p class="reservation-hero__subtitle">Choisissez le créneau qui vous convient — réponse de confirmation sous 24h</p>
    </section>

    {# Steps #}
    <div class="reservation-steps">
        <div class="reservation-steps__inner">
            <div class="res-step is-active" id="step-1">
                <div class="res-step__num">1</div>
                <span class="res-step__label">Choisir un créneau</span>
            </div>
            <div class="res-step__sep"></div>
            <div class="res-step" id="step-2">
                <div class="res-step__num">2</div>
                <span class="res-step__label">Vos informations</span>
            </div>
            <div class="res-step__sep"></div>
            <div class="res-step" id="step-3">
                <div class="res-step__num">3</div>
                <span class="res-step__label">Confirmation</span>
            </div>
        </div>
    </div>

    {# Body #}
    <div class="reservation-body">
        <div class="reservation-layout">

            {# Calendrier #}
            <div class="calendar-card">
                <div class="calendar-card__head">
                    <span class="calendar-card__title">Sélectionnez un créneau</span>
                    <div class="calendar-card__legend">
                        <span><span class="legend-dot legend-dot--free"></span>Disponible</span>
                        <span><span class="legend-dot legend-dot--taken"></span>Indisponible</span>
                    </div>
                </div>
                <div class="calendar-card__body">
                    <div id="reservation-calendar"></div>
                </div>
            </div>

            {# Sidebar #}
            <div class="reservation-sidebar">

                {# Créneau sélectionné #}
                <div class="res-info-card">
                    <p class="res-info-card__title">Créneau sélectionné</p>
                    <div class="res-info-card__selected" id="selected-slot-display">
                        Cliquez sur un créneau<br>disponible dans le calendrier
                    </div>
                </div>

                {# Horaires #}
                <div class="res-info-card">
                    <p class="res-info-card__title">Nos horaires</p>
                    <div class="res-horaires">
                        <div class="res-horaire-item">
                            <span>Lundi – Vendredi</span>
                            <span>9h – 17h</span>
                        </div>
                        <div class="res-horaire-item">
                            <span>Samedi</span>
                            <span>Fermé</span>
                        </div>
                        <div class="res-horaire-item">
                            <span>Dimanche</span>
                            <span>Fermé</span>
                        </div>
                        <div class="res-horaire-item">
                            <span>Durée consultation</span>
                            <span>1 heure</span>
                        </div>
                    </div>
                </div>

                {# Infos #}
                <div class="res-info-card">
                    <p class="res-info-card__title">Bon à savoir</p>
                    <div class="res-horaires">
                        <div class="res-horaire-item" style="flex-direction:column;align-items:flex-start;gap:4px;border:0;padding-bottom:12px">
                            <span style="font-weight:600;color:#111;font-size:0.85rem">Consultation gratuite</span>
                            <span style="color:#64748b;font-size:0.82rem;line-height:1.5">Votre première consultation est offerte et sans engagement.</span>
                        </div>
                        <div class="res-horaire-item" style="flex-direction:column;align-items:flex-start;gap:4px;border:0;padding-top:0">
                            <span style="font-weight:600;color:#111;font-size:0.85rem">Confirmation sous 24h</span>
                            <span style="color:#64748b;font-size:0.82rem;line-height:1.5">Vous recevrez un email de confirmation après validation de votre demande.</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

{# Modal #}
<div class="res-modal-backdrop" id="res-modal-backdrop">
    <div class="res-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="res-modal__head">
            <div>
                <p class="res-modal__head-title" id="modal-title">Confirmer votre rendez-vous</p>
                <p class="res-modal__head-slot" id="modal-slot-label"></p>
            </div>
            <button class="res-modal__close" id="modal-close" aria-label="Fermer">&times;</button>
        </div>
        <form class="res-modal__body" id="res-form" novalidate>
            <div class="res-modal__row">
                <div class="res-modal__group">
                    <label class="res-modal__label" for="res-prenom">Prénom <span class="res-modal__required">*</span></label>
                    <input type="text" id="res-prenom" name="prenom" class="res-modal__input" placeholder="Votre prénom" required>
                </div>
                <div class="res-modal__group">
                    <label class="res-modal__label" for="res-nom">Nom <span class="res-modal__required">*</span></label>
                    <input type="text" id="res-nom" name="nom" class="res-modal__input" placeholder="Votre nom" required>
                </div>
            </div>
            <div class="res-modal__group">
                <label class="res-modal__label" for="res-email">Email <span class="res-modal__required">*</span></label>
                <input type="email" id="res-email" name="email" class="res-modal__input" placeholder="votre@email.com" required>
            </div>
            <div class="res-modal__group">
                <label class="res-modal__label" for="res-tel">Téléphone</label>
                <input type="tel" id="res-tel" name="tel" class="res-modal__input" placeholder="+33 6 00 00 00 00">
            </div>
            <div class="res-modal__group">
                <label class="res-modal__label" for="res-soin">Soin souhaité <span class="res-modal__required">*</span></label>
                <select id="res-soin" name="soin" class="res-modal__select" required>
                    <option value="" disabled selected>Sélectionnez un soin</option>
                    <option value="consultation">Première consultation</option>
                    <option value="greffe-fue">Greffe capillaire FUE</option>
                    <option value="greffe-dhi">Greffe capillaire DHI</option>
                    <option value="greffe-barbe">Greffe de barbe</option>
                    <option value="dentisterie">Dentisterie esthétique</option>
                    <option value="autre">Autre</option>
                </select>
            </div>
        </form>
        <div class="res-modal__footer">
            <button class="res-modal__btn-cancel" id="modal-cancel">Annuler</button>
            <button class="res-modal__btn-confirm" id="modal-confirm">Confirmer le rendez-vous</button>
        </div>
    </div>
</div>

{# Toast confirmation #}
<div class="res-toast" id="res-toast">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
        <polyline points="20 6 9 17 4 12"/>
    </svg>
    Demande envoyée ! Nous vous confirmons sous 24h.
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    /* ── Créneaux "pris" simulés (à remplacer par une API) ── */
    var takenSlots = [
        { date: getNextWeekday(1), hour: 9  },
        { date: getNextWeekday(1), hour: 14 },
        { date: getNextWeekday(2), hour: 10 },
        { date: getNextWeekday(3), hour: 11 },
        { date: getNextWeekday(3), hour: 15 },
        { date: getNextWeekday(4), hour: 13 },
    ];

    function getNextWeekday(dayOfWeek) {
        var today = new Date();
        var diff = (dayOfWeek - today.getDay() + 7) % 7 || 7;
        var d = new Date(today);
        d.setDate(today.getDate() + diff);
        return d.toISOString().split('T')[0];
    }

    function isTaken(dateStr, hour) {
        return takenSlots.some(function (s) {
            return s.date === dateStr && s.hour === hour;
        });
    }

    /* Générer les events FullCalendar */
    function generateEvents(start, end) {
        var events = [];
        var cur = new Date(start);
        var endDate = new Date(end);

        while (cur <= endDate) {
            var day = cur.getDay();
            if (day >= 1 && day <= 5) {
                var dateStr = cur.toISOString().split('T')[0];
                for (var h = 9; h < 17; h++) {
                    var taken = isTaken(dateStr, h);
                    var startTime = pad(h) + ':00:00';
                    var endTime   = pad(h + 1) + ':00:00';
                    events.push({
                        title: taken ? 'Indisponible' : 'Disponible',
                        start: dateStr + 'T' + startTime,
                        end:   dateStr + 'T' + endTime,
                        classNames: [taken ? 'fc-slot-taken' : 'fc-slot-available'],
                        extendedProps: { taken: taken, hour: h, dateStr: dateStr }
                    });
                }
            }
            cur.setDate(cur.getDate() + 1);
        }
        return events;
    }

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    /* ── FullCalendar init ── */
    var calEl = document.getElementById('reservation-calendar');
    var calendar = new FullCalendar.Calendar(calEl, {
        locale: 'fr',
        initialView: 'timeGridWeek',
        headerToolbar: {
            left:   'prev,next today',
            center: 'title',
            right:  ''
        },
        hiddenDays: [0, 6],
        slotMinTime: '09:00:00',
        slotMaxTime: '17:00:00',
        slotDuration: '01:00:00',
        slotLabelInterval: '01:00:00',
        allDaySlot: false,
        expandRows: true,
        height: 'auto',
        nowIndicator: true,
        validRange: {
            start: new Date().toISOString().split('T')[0]
        },
        events: function (info, successCallback) {
            successCallback(generateEvents(info.start, info.end));
        },
        eventClick: function (info) {
            if (info.event.extendedProps.taken) return;
            openModal(info.event);
        },
        eventDidMount: function (info) {
            if (info.event.extendedProps.taken) {
                info.el.style.cursor = 'not-allowed';
            }
        },
        buttonText: {
            today: "Aujourd'hui"
        }
    });

    calendar.render();

    /* ── Modal ── */
    var backdrop    = document.getElementById('res-modal-backdrop');
    var modalSlot   = document.getElementById('modal-slot-label');
    var closeBtn    = document.getElementById('modal-close');
    var cancelBtn   = document.getElementById('modal-cancel');
    var confirmBtn  = document.getElementById('modal-confirm');
    var slotDisplay = document.getElementById('selected-slot-display');
    var step1       = document.getElementById('step-1');
    var step2       = document.getElementById('step-2');
    var step3       = document.getElementById('step-3');
    var toast       = document.getElementById('res-toast');

    var selectedEvent = null;

    var DAYS_FR = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
    var MONTHS_FR = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];

    function formatSlot(event) {
        var d = event.start;
        return DAYS_FR[d.getDay()] + ' ' + d.getDate() + ' ' + MONTHS_FR[d.getMonth()] + ' — ' + pad(d.getHours()) + 'h–' + pad(d.getHours() + 1) + 'h';
    }

    function openModal(event) {
        selectedEvent = event;
        var label = formatSlot(event);
        modalSlot.textContent = label;
        slotDisplay.innerHTML = 'Votre créneau :<strong>' + label + '</strong>';
        slotDisplay.classList.add('has-slot');
        step1.classList.remove('is-active');
        step1.classList.add('is-done');
        step2.classList.add('is-active');
        backdrop.classList.add('is-open');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        backdrop.classList.remove('is-open');
        document.body.style.overflow = '';
        step2.classList.remove('is-active');
        step1.classList.remove('is-done');
        step1.classList.add('is-active');
    }

    closeBtn.addEventListener('click', closeModal);
    cancelBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', function (e) {
        if (e.target === backdrop) closeModal();
    });

    confirmBtn.addEventListener('click', function () {
        var form = document.getElementById('res-form');
        var prenom = document.getElementById('res-prenom').value.trim();
        var nom    = document.getElementById('res-nom').value.trim();
        var email  = document.getElementById('res-email').value.trim();
        var soin   = document.getElementById('res-soin').value;

        if (!prenom || !nom || !email || !soin) {
            var inputs = form.querySelectorAll('[required]');
            inputs.forEach(function (el) {
                if (!el.value.trim()) {
                    el.style.borderColor = '#ef4444';
                    el.addEventListener('input', function () {
                        el.style.borderColor = '';
                    }, { once: true });
                }
            });
            return;
        }

        /* Marquer le créneau comme pris */
        if (selectedEvent) {
            var ep = selectedEvent.extendedProps;
            takenSlots.push({ date: ep.dateStr, hour: ep.hour });
            calendar.refetchEvents();
        }

        backdrop.classList.remove('is-open');
        document.body.style.overflow = '';
        form.reset();

        step2.classList.remove('is-active');
        step2.classList.add('is-done');
        step3.classList.add('is-active');

        toast.classList.add('is-visible');
        setTimeout(function () {
            toast.classList.remove('is-visible');
        }, 4000);
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && backdrop.classList.contains('is-open')) closeModal();
    });
});
</script>
{% endblock %}
