<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Alliance Esthetic — Implantologie Capillaire à Paris{% endblock %}</title>
    <meta name="description" content="{% block description %}Clinique d'excellence en implantologie capillaire à Paris. Techniques FUE & DHI pour des résultats naturels et durables.{% endblock %}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('css/app.css') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body>

    {# ===== TOP BAR ===== #}
    <div class="topbar">
        <div class="topbar-inner">
            <div class="topbar-contact">
                <a href="tel:+33123456789">
                    <span class="icon">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.57a16 16 0 0 0 6.29 6.29l.94-.94a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </span>
                    +33 1 23 45 67 89
                </a>
                <a href="mailto:contact@alliance-esthetic.fr">
                    <span class="icon">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    </span>
                    contact@alliance-esthetic.fr
                </a>
            </div>
            <div class="topbar-social">
                <a href="#" aria-label="Instagram" target="_blank" rel="noopener">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                </a>
                <a href="#" aria-label="Facebook" target="_blank" rel="noopener">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                </a>
            </div>
        </div>
    </div>

    {# ===== HEADER ===== #}
    <header class="header" id="header">
        <div class="header-inner">
            <a href="{{ path('app_home') }}" class="logo">
                <span class="logo-alliance">ALLIANCE</span>
                <span class="logo-esthetic">Esthetic</span>
            </a>

            <nav class="nav">
                <a href="{{ path('app_home') }}" class="{{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}">Accueil</a>
                <a href="#">Services</a>
                <a href="#">Assurance</a>
                <a href="#">Contact</a>
            </nav>

            <a href="#contact" class="btn-rdv">Prendre rendez-vous</a>
        </div>
    </header>

    {# ===== MAIN CONTENT ===== #}
    <main>
        {% block body %}{% endblock %}
    </main>

    {# ===== FOOTER ===== #}
    <footer class="footer">
        <div class="footer-separator"></div>
        <div class="footer-inner">
            <div class="footer-brand">
                <a href="{{ path('app_home') }}" class="logo">
                    <span class="logo-alliance">ALLIANCE</span>
                    <span class="logo-esthetic">Esthetic</span>
                </a>
                <p>Votre clinique esthétique d'excellence. Nous révélons votre beauté naturelle grâce à des techniques innovantes et une approche sur mesure.</p>
            </div>

            <div class="footer-links">
                <h4>Liens rapides</h4>
                <ul>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="#">Services</a></li>
                    <li><a href="#">Assurance</a></li>
                    <li><a href="#">Contact</a></li>
                </ul>
            </div>

            <div class="footer-contact">
                <h4>Contact</h4>
                <div class="footer-contact-item">
                    <span class="contact-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </span>
                    <span>15 Avenue des Champs-Élysées<br>75008 Paris, France</span>
                </div>
                <div class="footer-contact-item">
                    <span class="contact-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.57a16 16 0 0 0 6.29 6.29l.94-.94a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </span>
                    <a href="tel:+33123456789">+33 1 23 45 67 89</a>
                </div>
                <div class="footer-contact-item">
                    <span class="contact-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    </span>
                    <a href="mailto:contact@alliance-esthetic.fr">contact@alliance-esthetic.fr</a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© {{ "now"|date("Y") }} Alliance Esthetic. Tous droits réservés.</p>
        </div>
    </footer>

    <script src="{{ asset('js/app.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
