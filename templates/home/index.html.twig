{% extends 'base.html.twig' %}
{% from 'partials/_icons.html.twig' import check, linkedin, twitter, star %}

{% block title %}Alliance Esthetic — Accueil{% endblock %}

{% block body %}

    {# Hero Section #}
    <section class="hero">
        <video class="hero__video" autoplay muted loop playsinline>
            <source src="{{ asset('videos/hero.mp4') }}?v=2" type="video/mp4">
        </video>
        <div class="hero__overlay"></div>
        <div class="hero__content">
            <h1 class="hero__title">Révélez votre beauté naturelle</h1>
            <p class="hero__subtitle">Spécialistes en implantologie capillaire et dentisterie esthétique — des résultats durables qui vous ressemblent</p>
            <div class="hero__actions">
                <a href="{{ path('app_reservation') }}" class="btn btn--primary">Prendre rendez-vous</a>
                <a href="{{ path('app_services') }}" class="btn btn--outline">Découvrir nos soins</a>
            </div>
        </div>
    </section>

    {# Section Explication #}
    <section class="explication">
        <div class="container">
            <div class="explication__grid">

                <div class="explication__content reveal reveal--left">
                    <span class="explication__label">BIENVENUE CHEZ ALLIANCE ESTHETIC</span>
                    <h2 class="explication__title">L'art subtil de révéler<br>votre <span class="explication__title--gold">beauté naturelle.</span></h2>
                    <p class="explication__desc">Spécialistes de la greffe capillaire et de l'esthétique médicale, nous combinons expertise chirurgicale et technologies de pointe pour des résultats durables, naturels et personnalisés. Chaque patient est unique — chaque traitement l'est aussi.</p>
                    <div class="explication__actions">
                        <a href="{{ path('app_services') }}" class="btn btn--dark">DÉCOUVRIR NOS SOINS</a>
                        <a href="{{ path('app_reservation') }}" class="btn btn--outline-dark">CONSULTATION INITIALE</a>
                    </div>
                </div>

                <div class="explication__media reveal reveal--right">
                    <div class="explication__img-wrapper">
                        <img src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=800&q=80" alt="Clinique Alliance Esthetic" loading="lazy">
                    </div>
                    <div class="explication__card">
                        <div class="explication__card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                        </div>
                        <div class="explication__card-body">
                            <p class="explication__card-title">Expertise Médicale</p>
                            <p class="explication__card-text">Une équipe certifiée, des résultats reconnus depuis plus de 10 ans.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    {# Section Témoignages #}
    <section class="testimonials testimonials--pinned" id="testimonials">
        <div class="testimonials__pin">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title">Ce que disent nos clients</h2>
                    <p class="section-subtitle">Leur confiance est notre plus grande fierté</p>
                </div>
            </div>
            <div class="testimonials__track" id="testimonials-track">
                <div class="testimonials__card">
                    <div class="testimonials__stars">{% for s in 1..5 %}{{ star() }}{% endfor %}</div>
                    <p class="testimonials__text">"Alliance Esthetic a transformé ma vie. Le résultat est naturel, dense et indétectable. Je recommande à 100%."</p>
                    <div class="testimonials__author">
                        <div class="testimonials__avatar">TM</div>
                        <div>
                            <p class="testimonials__name">Thomas M.</p>
                            <p class="testimonials__role">Greffe FUE — Mars 2026</p>
                        </div>
                    </div>
                </div>
                <div class="testimonials__card">
                    <div class="testimonials__stars">{% for s in 1..5 %}{{ star() }}{% endfor %}</div>
                    <p class="testimonials__text">"Technique DHI impeccable. L'équipe est professionnelle et rassurante du début à la fin. Résultats visibles dès 6 mois."</p>
                    <div class="testimonials__author">
                        <div class="testimonials__avatar">KB</div>
                        <div>
                            <p class="testimonials__name">Karim B.</p>
                            <p class="testimonials__role">Technique DHI — Février 2026</p>
                        </div>
                    </div>
                </div>
                <div class="testimonials__card">
                    <div class="testimonials__stars">{% for s in 1..5 %}{{ star() }}{% endfor %}</div>
                    <p class="testimonials__text">"Ma barbe est enfin dense et naturelle. Intervention sans douleur, récupération rapide. Merci à toute l'équipe."</p>
                    <div class="testimonials__author">
                        <div class="testimonials__avatar">AD</div>
                        <div>
                            <p class="testimonials__name">Alexandre D.</p>
                            <p class="testimonials__role">Greffe de Barbe — Janvier 2026</p>
                        </div>
                    </div>
                </div>
                <div class="testimonials__card">
                    <div class="testimonials__stars">{% for s in 1..5 %}{{ star() }}{% endfor %}</div>
                    <p class="testimonials__text">"Un suivi post-opératoire exceptionnel. Chaque étape expliquée, chaque question répondue. Je me suis senti entre de bonnes mains."</p>
                    <div class="testimonials__author">
                        <div class="testimonials__avatar">RN</div>
                        <div>
                            <p class="testimonials__name">Rachid N.</p>
                            <p class="testimonials__role">Greffe FUE — Décembre 2025</p>
                        </div>
                    </div>
                </div>
                <div class="testimonials__card">
                    <div class="testimonials__stars">{% for s in 1..5 %}{{ star() }}{% endfor %}</div>
                    <p class="testimonials__text">"Résultat bluffant après seulement 8 mois. Les greffons ont poussé uniformément et ça ressemble à des vrais cheveux."</p>
                    <div class="testimonials__author">
                        <div class="testimonials__avatar">SL</div>
                        <div>
                            <p class="testimonials__name">Sofiane L.</p>
                            <p class="testimonials__role">Implantologie — Novembre 2025</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof gsap === 'undefined' || window.innerWidth < 769) return;
            gsap.registerPlugin(ScrollTrigger);
            var track = document.getElementById('testimonials-track');
            var pin = document.querySelector('.testimonials__pin');
            if (!track || !pin) return;
            var headerH = document.getElementById('site-header') ? document.getElementById('site-header').offsetHeight : 0;
            var scrollDistance = track.scrollWidth - window.innerWidth;
            gsap.to(track, {
                x: -scrollDistance,
                ease: 'none',
                scrollTrigger: {
                    trigger: '#testimonials',
                    pin: pin,
                    pinSpacing: true,
                    start: 'top ' + headerH,
                    end: '+=' + (scrollDistance + 200),
                    scrub: 1,
                    anticipatePin: 1
                }
            });
        });
    </script>

    {# Section Nos Prestations #}
    <section class="services" id="services">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Nos Prestations</h2>
                <p class="section-subtitle">Des solutions expertes adaptées à chaque besoin</p>
            </div>
            <div class="svc-cards__grid" data-stagger>

                <div class="svc-card reveal">
                    <div class="svc-card__image">
                        <img src="https://images.unsplash.com/photo-1622286342621-4bd786c2447c?auto=format&fit=crop&w=800&q=80" alt="Implantologie Capillaire" loading="lazy">
                        <div class="svc-card__icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2a5 5 0 015 5c0 3-2 5.5-5 8-3-2.5-5-5-5-8a5 5 0 015-5z"/>
                                <line x1="12" y1="15" x2="12" y2="22"/>
                            </svg>
                        </div>
                    </div>
                    <div class="svc-card__body">
                        <h3 class="svc-card__title">Implantologie Capillaire</h3>
                        <p class="svc-card__desc">Des techniques de pointe pour redensifier votre chevelure ou votre barbe. Des résultats naturels, denses et durables grâce à notre expertise en micro-greffe capillaire.</p>
                        <a href="{{ path('app_services') }}" class="arrow-link">EN SAVOIR PLUS <span>&rarr;</span></a>
                    </div>
                </div>

                <div class="svc-card reveal">
                    <div class="svc-card__image">
                        <img src="https://images.unsplash.com/photo-1606811841689-23dfddce3e95?auto=format&fit=crop&w=800&q=80" alt="Dentisterie Esthétique" loading="lazy">
                        <div class="svc-card__icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2c-2.5 0-5 1.5-5 4 0 1.5.5 3 1 4.5C9 13 9.5 16 9 18c-.3 1.5 0 3 1.5 3s2-1.5 1.5-3c-.3-1 0-2 0-2s.3 1 0 2c-.5 1.5 0 3 1.5 3s1.8-1.5 1.5-3c-.5-2 0-5 1-7.5.5-1.5 1-3 1-4.5 0-2.5-2.5-4-5-4z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="svc-card__body">
                        <h3 class="svc-card__title">Dentisterie Esthétique</h3>
                        <p class="svc-card__desc">Un sourire parfait grâce à nos solutions de blanchiment, facettes et alignement dentaire. Des traitements personnalisés pour révéler votre plus beau sourire en toute sérénité.</p>
                        <a href="{{ path('app_services') }}" class="arrow-link">EN SAVOIR PLUS <span>&rarr;</span></a>
                    </div>
                </div>

            </div>
        </div>
    </section>

{% endblock %}
