{% extends 'base.html.twig' %}
{% from 'partials/_icons.html.twig' import phone, email, location %}

{% block title %}Alliance Esthetic — Contact{% endblock %}

{% block body %}

    {# Hero Contact #}
    <section class="contact-hero">
        <div class="container">
            <h1 class="contact-hero__title">Démarrons votre parcours beauté</h1>
            <p class="contact-hero__subtitle">
                Remplissez le formulaire ci-dessous et recevez une réponse personnalisée sous 24h
            </p>
        </div>
    </section>

    {# Contact Content #}
    <section class="contact-content">
        <div class="container">
            <div class="contact-grid">

                {# Left: Formulaire #}
                <div class="contact-form-card reveal reveal--left">
                    <h2 class="contact-form__title">Envoyez-nous un message</h2>

                    <form class="contact-form" action="#" method="post">

                        <div class="contact-form__group">
                            <label class="contact-form__label" for="contact-name">Nom complet <span class="contact-form__required">*</span></label>
                            <input type="text" id="contact-name" name="name" class="contact-form__input" placeholder="Votre nom" required>
                        </div>

                        <div class="contact-form__group">
                            <label class="contact-form__label" for="contact-email">Email <span class="contact-form__required">*</span></label>
                            <input type="email" id="contact-email" name="email" class="contact-form__input" placeholder="votre@email.com" required>
                        </div>

                        <div class="contact-form__group">
                            <label class="contact-form__label" for="contact-motif">Soin souhaité <span class="contact-form__required">*</span></label>
                            <select id="contact-motif" name="motif" class="contact-form__input contact-form__select" required>
                                <option value="" disabled selected>Sélectionnez un soin</option>
                                <option value="consultation">Première consultation</option>
                                <option value="greffe-fue">Greffe capillaire FUE</option>
                                <option value="greffe-dhi">Greffe capillaire DHI</option>
                                <option value="greffe-barbe">Greffe de barbe</option>
                                <option value="dentisterie">Dentisterie esthétique</option>
                                <option value="autre">Autre</option>
                            </select>
                        </div>

                        <div class="contact-form__group">
                            <label class="contact-form__label" for="contact-message">Message</label>
                            <textarea id="contact-message" name="message" class="contact-form__input contact-form__textarea" placeholder="Décrivez votre demande en quelques mots..." rows="5"></textarea>
                        </div>

                        <div class="contact-form__check">
                            <input type="checkbox" id="contact-rgpd" name="rgpd" required>
                            <label for="contact-rgpd">J'accepte les <a href="{{ path('app_politique_confidentialite') }}">conditions générales de protection des données</a></label>
                        </div>

                        <button type="submit" class="contact-form__submit">
                            Envoyer ma demande
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                                <line x1="22" y1="2" x2="11" y2="13"/>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                            </svg>
                        </button>

                        <p class="contact-form__disclaimer">* Champs obligatoires &bull; Réponse garantie sous 24h</p>
                    </form>
                </div>

                {# Right: Sidebar #}
                <div class="contact-sidebar reveal reveal--right">

                    {# Carte infos de contact #}
                    <div class="contact-card">
                        <h3 class="contact-card__title">Informations de contact</h3>
                        <p class="contact-card__text">Vous préférez nous contacter directement ? Utilisez l'un des moyens ci-dessous. Nous sommes là pour répondre à toutes vos questions.</p>

                        <div class="contact-card__items">
                            <div class="contact-card__item">
                                <div class="contact-card__icon">
                                    {{ email() }}
                                </div>
                                <div>
                                    <span class="contact-card__item-label">Email</span>
                                    <a href="mailto:contact@alliance-esthetic.fr" class="contact-card__item-value">contact@alliance-esthetic.fr</a>
                                </div>
                            </div>

                            <div class="contact-card__item">
                                <div class="contact-card__icon">
                                    {{ phone() }}
                                </div>
                                <div>
                                    <span class="contact-card__item-label">Téléphone (1er contact)</span>
                                    <a href="tel:+33123456789" class="contact-card__item-value">+33 1 23 45 67 89</a>
                                </div>
                            </div>

                            <div class="contact-card__item">
                                <div class="contact-card__icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                </div>
                                <div>
                                    <span class="contact-card__item-label">Disponibilité</span>
                                    <span class="contact-card__item-value">Lun-Sam : 9h-19h</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Carte réseaux sociaux #}
                    <div class="contact-card contact-card--social">
                        <h3 class="contact-card__title">Suivez-nous</h3>
                        <div class="contact-social">
                            <a href="#" class="contact-social__link" aria-label="Instagram">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                                    <circle cx="12" cy="12" r="4"/>
                                    <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
                                </svg>
                            </a>
                            <a href="#" class="contact-social__link" aria-label="Facebook">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                                </svg>
                            </a>
                            <a href="mailto:contact@alliance-esthetic.fr" class="contact-social__link" aria-label="Email">
                                {{ email() }}
                            </a>
                        </div>
                    </div>

                    {# Carte avantages #}
                    <div class="contact-card contact-card--benefits">
                        <div class="contact-benefit">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Consultation initiale gratuite et sans engagement</span>
                        </div>
                        <div class="contact-benefit">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Réponse personnalisée sous 24h</span>
                        </div>
                        <div class="contact-benefit">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Premier échange téléphonique offert</span>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </section>

{% endblock %}
