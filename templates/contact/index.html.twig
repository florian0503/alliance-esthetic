{% extends 'base.html.twig' %}
{% from 'partials/_icons.html.twig' import phone, email, location, snapchat, whatsapp %}

{% block title %}Alliance Esthetic — Contact{% endblock %}

{% block body %}

    {# Hero Contact #}
    <section class="contact-hero">
        <div class="container">
            <h1 class="contact-hero__title">Démarrons votre parcours beauté</h1>
            <p class="contact-hero__subtitle">
                Remplissez le formulaire ci-dessous et recevez une réponse personnalisée sous 24h
            </p>
        </div>
    </section>

    {# Contact Content #}
    <section class="contact-content">
        <div class="container">
            <div class="contact-grid">

                {# Left: Formulaire #}
                <div class="contact-form-card reveal reveal--left">
                    <h2 class="contact-form__title">Envoyez-nous un message</h2>

                    {% for msg in app.flashes('contact_success') %}
                        <div class="contact-form__flash contact-form__flash--success">{{ msg }}</div>
                    {% endfor %}
                    {% for msg in app.flashes('contact_error') %}
                        <div class="contact-form__flash contact-form__flash--error">{{ msg }}</div>
                    {% endfor %}

                    <form class="contact-form" action="{{ path('app_contact') }}" method="post">

                        <div class="contact-form__group">
                            <label class="contact-form__label" for="contact-name">Nom complet <span class="contact-form__required">*</span></label>
                            <input type="text" id="contact-name" name="name" class="contact-form__input" placeholder="Votre nom" value="{{ old.nom ?? '' }}" required>
                        </div>

                        <div class="contact-form__group">
                            <label class="contact-form__label" for="contact-email">Email <span class="contact-form__required">*</span></label>
                            <input type="email" id="contact-email" name="email" class="contact-form__input" placeholder="votre@email.com" value="{{ old.email ?? '' }}" required>
                        </div>

                        <div class="contact-form__group">
                            <label class="contact-form__label" for="contact-motif">Soin souhaité <span class="contact-form__required">*</span></label>
                            <select id="contact-motif" name="motif" class="contact-form__input contact-form__select" required>
                                <option value="" disabled {{ (old.motif ?? '') == '' ? 'selected' : '' }}>Sélectionnez un soin</option>
                                <option value="consultation" {{ (old.motif ?? '') == 'consultation' ? 'selected' : '' }}>Première consultation</option>
                                <option value="greffe-fue" {{ (old.motif ?? '') == 'greffe-fue' ? 'selected' : '' }}>Greffe capillaire FUE</option>
                                <option value="greffe-dhi" {{ (old.motif ?? '') == 'greffe-dhi' ? 'selected' : '' }}>Greffe capillaire DHI</option>
                                <option value="greffe-barbe" {{ (old.motif ?? '') == 'greffe-barbe' ? 'selected' : '' }}>Greffe de barbe</option>
                                <option value="dentisterie" {{ (old.motif ?? '') == 'dentisterie' ? 'selected' : '' }}>Dentisterie esthétique</option>
                                <option value="autre" {{ (old.motif ?? '') == 'autre' ? 'selected' : '' }}>Autre</option>
                            </select>
                        </div>

                        <div class="contact-form__group">
                            <label class="contact-form__label" for="contact-message">Message</label>
                            <textarea id="contact-message" name="message" class="contact-form__input contact-form__textarea" placeholder="Décrivez votre demande en quelques mots..." rows="5">{{ old.message ?? '' }}</textarea>
                        </div>

                        <div class="contact-form__check">
                            <input type="checkbox" id="contact-rgpd" name="rgpd" required>
                            <label for="contact-rgpd">J'accepte la <a href="{{ path('app_politique_confidentialite') }}">politique de protection des données</a></label>
                        </div>

                        <button type="submit" class="contact-form__submit">
                            Envoyer ma demande
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                                <line x1="22" y1="2" x2="11" y2="13"/>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                            </svg>
                        </button>

                        <p class="contact-form__disclaimer">* Champs obligatoires &bull; Réponse garantie sous 24h</p>
                    </form>
                </div>

                {# Right: Sidebar #}
                <div class="contact-sidebar reveal reveal--right">

                    {# Carte infos de contact #}
                    <div class="contact-card">
                        <h3 class="contact-card__title">Informations de contact</h3>
                        <p class="contact-card__text">Vous préférez nous contacter directement ? Utilisez l'un des moyens ci-dessous. Nous sommes là pour répondre à toutes vos questions.</p>

                        <div class="contact-card__items">
                            <div class="contact-card__item">
                                <div class="contact-card__icon">
                                    {{ email() }}
                                </div>
                                <div>
                                    <span class="contact-card__item-label">Email</span>
                                    <a href="mailto:boubsw@gmail.com" class="contact-card__item-value">boubsw@gmail.com</a>
                                </div>
                            </div>

                            <div class="contact-card__item">
                                <div class="contact-card__icon">
                                    {{ phone() }}
                                </div>
                                <div>
                                    <span class="contact-card__item-label">Téléphone France</span>
                                    <a href="tel:+33614863505" class="contact-card__item-value">06 14 86 35 05</a>
                                </div>
                            </div>

                            <div class="contact-card__item">
                                <div class="contact-card__icon">
                                    {{ phone() }}
                                </div>
                                <div>
                                    <span class="contact-card__item-label">GSM Algérie</span>
                                    <a href="tel:+213676774652" class="contact-card__item-value">00213 6 76 77 46 52</a>
                                </div>
                            </div>

                            <div class="contact-card__item">
                                <div class="contact-card__icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                </div>
                                <div>
                                    <span class="contact-card__item-label">Disponibilité</span>
                                    <span class="contact-card__item-value">Lun-Sam : 9h-19h</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Carte réseaux sociaux #}
                    <div class="contact-card contact-card--social">
                        <h3 class="contact-card__title">Suivez-nous</h3>
                        <div class="contact-social">
                            <a href="{{ social_whatsapp_url }}" class="contact-social__link" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">{{ whatsapp() }}</a>
                            <a href="{{ social_snapchat_url }}" class="contact-social__link" target="_blank" rel="noopener noreferrer" aria-label="Snapchat">{{ snapchat() }}</a>
                        </div>
                    </div>

                    {# Carte avantages #}
                    <div class="contact-card contact-card--benefits">
                        <div class="contact-benefit">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Consultation initiale gratuite et sans engagement</span>
                        </div>
                        <div class="contact-benefit">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Réponse personnalisée sous 24h</span>
                        </div>
                        <div class="contact-benefit">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Premier échange téléphonique offert</span>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </section>

{% endblock %}
